# Decide9ja Docker Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=decide9ja
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=decide9ja

# API Keys (Required)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Twilio (Optional - for WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Redis (auto-configured in docker-compose)
# REDIS_URL=redis://redis:6379/0

# Scheduler Settings
NEWS_SCRAPE_INTERVAL_HOURS=1
ISSUE_EXTRACTION_LIMIT=20
