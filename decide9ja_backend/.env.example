# ===========================================
# Decide9ja Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# ENVIRONMENT
# ===========================================
ENVIRONMENT=development   # "development" or "production"
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=text           # "text" for development, "json" for production

# ===========================================
# DATABASE
# ===========================================
# SQLite for local development
DATABASE_URL=sqlite:///./decide9ja.db

# PostgreSQL for production (uncomment and configure)
# DATABASE_URL=postgresql://user:password@host:5432/decide9ja

# ===========================================
# REDIS (Session Storage)
# ===========================================
# Required for production (persistent sessions across restarts)
# Upstash Redis URL format:
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# Alternative: standard Redis
# REDIS_URL=redis://localhost:6379/0

# Session TTL in seconds (default: 30 minutes)
REDIS_SESSION_TTL=1800

# ===========================================
# SENTRY (Error Monitoring)
# ===========================================
# Get your DSN from https://sentry.io
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Performance monitoring sample rates (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ===========================================
# API KEYS
# ===========================================
# Anthropic Claude API (required for LLM responses)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (required for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# TWILIO (WhatsApp Integration)
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ===========================================
# SECURITY
# ===========================================
# Comma-separated list of allowed origins for CORS
# Use * for development, specific domains for production
ALLOWED_ORIGINS=*

# For production, use:
# ALLOWED_ORIGINS=https://decide9ja.ng,https://www.decide9ja.ng

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Google Maps API (for location features)
# GOOGLE_MAPS_API_KEY=your_google_maps_key

# News API (for real-time news)
# NEWS_API_KEY=your_news_api_key
