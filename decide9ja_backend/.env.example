# Decide9ja Backend Environment Variables

# Anthropic Claude API Key (required for LLM responses)
ANTHROPIC_API_KEY=your_api_key_here

# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Database (SQLite for local, PostgreSQL URL for prod)
DATABASE_URL=sqlite:///./decide9ja.db

# Environment
ENVIRONMENT=development
DEBUG=true

# ===========================================
# WhatsApp Business API (Meta Cloud API)
# ===========================================
# Get these from: developers.facebook.com → Your App → WhatsApp → API Setup

# Phone Number ID (from API Setup page)
WHATSAPP_PHONE_NUMBER_ID=

# Access Token (use permanent token from System User for production)
WHATSAPP_ACCESS_TOKEN=

# Verify Token (any random string you create - must match webhook config)
WHATSAPP_VERIFY_TOKEN=decide9ja_verify_2024

# Business Account ID (optional, from WhatsApp Business Account settings)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ===========================================
# Twilio (Optional - for sandbox testing)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
