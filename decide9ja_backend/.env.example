# Decide9ja Backend Environment Variables

# Anthropic Claude API Key (required for LLM responses)
ANTHROPIC_API_KEY=your_api_key_here

# OpenAI API Key (required for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Database (SQLite for local, PostgreSQL URL for prod)
DATABASE_URL=sqlite:///./decide9ja.db

# Environment
ENVIRONMENT=development
DEBUG=true
