# Procfile for Railway deployment
# Main web process (production with gunicorn)
web: gunicorn app.main:app --workers 4 --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:$PORT --timeout 120

# Background worker for scheduled tasks (separate Railway service)
worker: python -m app.scheduler_unified

# Crawler worker for news ingestion (separate Railway service)
crawler: python -m app.services.unified_crawler
