+#!/usr/bin/env python3
+"""
+Decide9ja — Unified Financial Data Ingestion
+=============================================
+Loads ALL available financial data into PostgreSQL:
+
+1. Findings (131 state budget anomalies) — from findings/*.json
+2. OpenTreasury transactions (246 daily payment files) — from raw_data/opentreasury/2025/
+3. Budget line items — from naijadata/ if available (Federal + State budgets)
+
+Usage:
+    python scripts/ingest_all_financial_data.py
+    python scripts/ingest_all_financial_data.py --dry-run
+    python scripts/ingest_all_financial_data.py --reset  # WARNING: clears existing data first
+    python scripts/ingest_all_financial_data.py --findings-only
+    python scripts/ingest_all_financial_data.py --transactions-only
+    python scripts/ingest_all_financial_data.py --budgets-only
+"""
+
+import json
+import logging
+import sys
+import os
+import glob
+import argparse
+from pathlib import Path
+from datetime import datetime
+from typing import List, Dict, Any, Optional
+
+# Setup paths - works from project root or scripts/ directory
+SCRIPT_DIR = Path(__file__).resolve().parent
+BACKEND_DIR = SCRIPT_DIR.parent
+PROJECT_ROOT = BACKEND_DIR.parent
+
+# Add backend to Python path
+sys.path.insert(0, str(BACKEND_DIR))
+
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s [%(levelname)s] %(message)s",
+    datefmt="%H:%M:%S",
+)
+logger = logging.getLogger(__name__)
+
+# ─────────────────────────────────────────────────────────────────────
+# Data source paths (relative to backend dir)
+# ─────────────────────────────────────────────────────────────────────
+
+# Findings JSON files
+FINDINGS_DIR = BACKEND_DIR / "findings"
+FINDINGS_FILES = [
+    FINDINGS_DIR / "new_state_findings.json",
+    FINDINGS_DIR / "webapp_all_findings.json",
+]
+
+# OpenTreasury raw Excel/CSV files
+OPENTREASURY_DIR = BACKEND_DIR / "raw_data" / "opentreasury" / "2025"
+
+# Budget data (naijadata) - multiple possible locations
+NAIJADATA_CANDIDATES = [
+    BACKEND_DIR / "data" / "naijadata" / "data",
+    PROJECT_ROOT / "data" / "naijadata" / "data",
+    BACKEND_DIR / "naijadata" / "data",
+    Path(os.path.expanduser("~/Decide9ja/data/naijadata/data")),
+]
+
+
+def get_naijadata_dir() -> Optional[Path]:
+    """Find the naijadata directory."""
+    for candidate in NAIJADATA_CANDIDATES:
+        if candidate.exists():
+            logger.info(f"Found naijadata at: {candidate}")
+            return candidate
+    return None
+
+
+# ─────────────────────────────────────────────────────────────────────
+# 1. FINDINGS INGESTION
+# ─────────────────────────────────────────────────────────────────────
+
+def ingest_findings(dry_run: bool = False) -> int:
+    """
+    Ingest financial intelligence findings from JSON files.
+    These are state budget anomalies with risk scores.
+    """
+    from app.database import SessionLocal, Finding
+
+    logger.info("=" * 60)
+    logger.info("STEP 1: Ingesting Financial Intelligence Findings")
+    logger.info("=" * 60)
+
+    all_findings = {}  # Use dict to deduplicate by ID
+
+    for findings_file in FINDINGS_FILES:
+        if not findings_file.exists():
+            logger.warning(f"  Findings file not found: {findings_file}")
+            continue
+
+        logger.info(f"  Loading: {findings_file.name}")
+        try:
+            with open(findings_file, "r") as f:
+                data = json.load(f)
+
+            findings_list = data.get("findings", [])
+            logger.info(f"  Found {len(findings_list)} findings in {findings_file.name}")
+
+            for item in findings_list:
+                fid = item.get("id", "")
+                if not fid:
+                    continue
+
+                # Deduplicate - keep the first occurrence
+                if fid not in all_findings:
+                    all_findings[fid] = {
+                        "id": str(fid),
+                        "risk_score": item.get("risk_score", 50),
+                        "title": item.get("type", "Unknown"),
+                        "description": item.get("description", ""),
+                        "jurisdiction": item.get("state", "Federal"),
+                        "year": item.get("year"),
+                        "mda": item.get("entity", "Unknown"),
+                        "amount": float(item.get("amount", 0) or 0),
+                        "project_name": item.get("entity", ""),
+                        "anomaly_type": item.get("type", ""),
+                        "enriched_analysis": json.dumps({
+                            "severity": item.get("severity"),
+                            "recommendation": item.get("recommendation"),
+                            "risk_factors": item.get("risk_factors", []),
+                        }),
+                    }
+
+        except Exception as e:
+            logger.error(f"  Error loading {findings_file.name}: {e}")
+
+    total = len(all_findings)
+    logger.info(f"  Total unique findings: {total}")
+
+    if dry_run or total == 0:
+        return total
+
+    # Insert into database
+    session = SessionLocal()
+    try:
+        inserted = 0
+        skipped = 0
+
+        for finding_data in all_findings.values():
+            # Check if already exists
+            existing = session.query(Finding).filter(Finding.id == finding_data["id"]).first()
+            if existing:
+                skipped += 1
+                continue
+
+            finding = Finding(**finding_data)
+            session.add(finding)
+            inserted += 1
+
+            if inserted % 50 == 0:
+                session.commit()
+                logger.info(f"    Committed {inserted} findings...")
+
+        session.commit()
+        logger.info(f"  ✅ Inserted {inserted} findings, skipped {skipped} duplicates")
+        return inserted
+
+    except Exception as e:
+        session.rollback()
+        logger.error(f"  ❌ Error inserting findings: {e}")
+        return 0
+    finally:
+        session.close()
+
+
+# ─────────────────────────────────────────────────────────────────────
+# 2. OPENTREASURY TRANSACTIONS INGESTION
+# ─────────────────────────────────────────────────────────────────────
+
+def ingest_opentreasury(dry_run: bool = False) -> int:
+    """
+    Ingest OpenTreasury daily payment Excel files.
+    246 files covering all months of 2025.
+    """
+    from app.database import SessionLocal, Transaction
+
+    logger.info("=" * 60)
+    logger.info("STEP 2: Ingesting OpenTreasury Daily Payments")
+    logger.info("=" * 60)
+
+    if not OPENTREASURY_DIR.exists():
+        logger.warning(f"  OpenTreasury directory not found: {OPENTREASURY_DIR}")
+        return 0
+
+    # Try importing pandas
+    try:
+        import pandas as pd
+    except ImportError:
+        logger.error("  pandas not installed. Run: pip install pandas openpyxl")
+        return 0
+
+    # Find all Excel/CSV files
+    files = sorted(OPENTREASURY_DIR.rglob("*.xlsx")) + sorted(OPENTREASURY_DIR.rglob("*.csv"))
+    logger.info(f"  Found {len(files)} payment files")
+
+    if dry_run:
+        for f in files[:5]:
+            logger.info(f"    [DRY RUN] Would process: {f.relative_to(OPENTREASURY_DIR)}")
+        return len(files)
+
+    session = SessionLocal()
+    total_ingested = 0
+    total_errors = 0
+
+    for file_path in files:
+        try:
+            relative = file_path.relative_to(OPENTREASURY_DIR)
+
+            if file_path.suffix == ".xlsx":
+                # Read without header first to find the actual header row
+                raw_df = pd.read_excel(file_path, header=None)
+
+                # Find the row containing column headers
+                header_idx = -1
+                for idx, row in raw_df.iterrows():
+                    row_str = str(row.values).upper()
+                    if "AMOUNT" in row_str and ("BENEFICIARY" in row_str or "NO" in row_str):
+                        header_idx = idx
+                        break
+
+                if header_idx != -1:
+                    df = pd.read_excel(file_path, header=header_idx)
+                else:
+                    df = pd.read_excel(file_path)
+            else:
+                df = pd.read_csv(file_path)
+
+            # Normalize column names
+            df.columns = [str(c).lower().strip() for c in df.columns]
+
+            count = 0
+            for _, row in df.iterrows():
+                try:
+                    # Extract payment number (unique ID)
+                    payment_no = (
+                        row.get("payment no")
+                        or row.get("payment_no")
+                        or row.get("no.")
+                        or row.get("no")
+                    )
+                    if not payment_no or pd.isna(payment_no):
+                        continue
+
+                    # Parse amount
+                    raw_amount = row.get("amount", 0)
+                    try:
+                        amount = float(
+                            str(raw_amount).replace(",", "").replace("₦", "").strip()
+                        )
+                    except (ValueError, TypeError):
+                        amount = 0.0
+
+                    if amount <= 0:
+                        continue
+
+                    # Build a unique ID from filename + payment_no
+                    txn_id = f"{file_path.stem}_{payment_no}"
+
+                    # Check for duplicate
+                    existing = session.query(Transaction).filter(Transaction.id == txn_id).first()
+                    if existing:
+                        continue
+
+                    txn = Transaction(
+                        id=txn_id,
+                        payment_date=str(
+                            row.get("date", file_path.stem)  # Use filename date as fallback
+                        ),
+                        payer=str(row.get("payer", "Federal Government")),
+                        receiver=str(row.get("beneficiary", row.get("receiver", "Unknown"))),
+                        amount=amount,
+                        description=str(row.get("description", row.get("purpose", ""))),
+                        source_url=str(relative),
+                        state="Federal",
+                    )
+                    session.add(txn)
+                    count += 1
+
+                    # Batch commit every 500 rows
+                    if count % 500 == 0:
+                        session.commit()
+
+                except Exception:
+                    continue
+
+            session.commit()
+            if count > 0:
+                logger.info(f"    {relative}: {count} transactions")
+            total_ingested += count
+
+        except Exception as e:
+            total_errors += 1
+            logger.warning(f"    Error processing {file_path.name}: {e}")
+            session.rollback()
+
+    session.close()
+    logger.info(f"  ✅ Total transactions ingested: {total_ingested}")
+    if total_errors:
+        logger.warning(f"  ⚠️  Files with errors: {total_errors}")
+    return total_ingested
+
+
+# ─────────────────────────────────────────────────────────────────────
+# 3. BUDGET INGESTION
+# ─────────────────────────────────────────────────────────────────────
+
+def ingest_budgets(dry_run: bool = False) -> int:
+    """
+    Ingest Federal and State budget line items from naijadata JSON files.
+    """
+    from app.database import SessionLocal, Budget
+
+    logger.info("=" * 60)
+    logger.info("STEP 3: Ingesting Budget Data")
+    logger.info("=" * 60)
+
+    naijadata = get_naijadata_dir()
+    if not naijadata:
+        logger.warning("  naijadata directory not found. Budget ingestion skipped.")
+        logger.info("  Expected locations checked:")
+        for c in NAIJADATA_CANDIDATES:
+            logger.info(f"    - {c}")
+        logger.info("  To ingest budgets, place naijadata/ in one of these locations.")
+        return 0
+
+    total_records = 0
+
+    # Federal budgets
+    federal_dir = naijadata / "federal"
+    if federal_dir.exists():
+        json_files = sorted(federal_dir.rglob("budget_items.json"))
+        logger.info(f"  Found {len(json_files)} Federal budget files")
+
+        for f in json_files:
+            try:
+                with open(f, "r") as jf:
+                    data = json.load(jf)
+                items = data.get("items", [])
+                logger.info(f"    {f.name}: {len(items)} items")
+                total_records += len(items)
+            except Exception as e:
+                logger.error(f"    Error reading {f}: {e}")
+    else:
+        logger.info("  No Federal budget directory found")
+
+    # State budgets
+    states_dir = naijadata / "states"
+    if states_dir.exists():
+        json_files = sorted(states_dir.rglob("all_years_budget_data.json"))
+        logger.info(f"  Found {len(json_files)} State budget files")
+
+        for f in json_files:
+            state_name = f.parent.name.replace("_", " ").title()
+            try:
+                with open(f, "r") as jf:
+                    data = json.load(jf)
+                items = data.get("items", []) if isinstance(data, dict) else data
+                logger.info(f"    {state_name}: {len(items)} items")
+                total_records += len(items)
+            except Exception as e:
+                logger.error(f"    Error reading {f}: {e}")
+    else:
+        logger.info("  No State budget directory found")
+
+    logger.info(f"  Total budget records found: {total_records}")
+
+    if dry_run or total_records == 0:
+        return total_records
+
+    # If we reach here, we have naijadata — run the full ingest
+    # Import and delegate to the existing ingest_budgets script logic
+    session = SessionLocal()
+    inserted = 0
+
+    try:
+        # Federal
+        if federal_dir.exists():
+            for f in sorted(federal_dir.rglob("budget_items.json")):
+                with open(f, "r") as jf:
+                    data = json.load(jf)
+                for item in data.get("items", []):
+                    budget = Budget(
+                        year=item.get("year"),
+                        jurisdiction="Federal",
+                        mda=item.get("mda", "Unknown"),
+                        project=item.get("description", "Unknown"),
+                        amount=float(item.get("amount", 0) or 0),
+                        source_file=item.get("source_file", ""),
+                        page=item.get("page", 0),
+                    )
+                    session.add(budget)
+                    inserted += 1
+                    if inserted % 5000 == 0:
+                        session.commit()
+                        logger.info(f"    Committed {inserted} records...")
+
+        # States
+        if states_dir.exists():
+            for f in sorted(states_dir.rglob("all_years_budget_data.json")):
+                state_name = f.parent.name.replace("_", " ").title()
+                with open(f, "r") as jf:
+                    data = json.load(jf)
+                items = data.get("items", []) if isinstance(data, dict) else data
+
+                for item in items:
+                    year = item.get("year")
+                    if not year:
+                        continue
+                    try:
+                        year = int(year)
+                    except (ValueError, TypeError):
+                        continue
+
+                    raw_amount = (
+                        item.get("amount")
+                        or item.get("approved_amount")
+                        or item.get("primary_amount")
+                    )
+                    if raw_amount is None:
+                        amounts = item.get("amounts")
+                        if isinstance(amounts, list) and amounts:
+                            raw_amount = amounts[0]
+
+                    try:
+                        if isinstance(raw_amount, str):
+                            amount = float(raw_amount.replace(",", "").replace("₦", "").strip())
+                        elif isinstance(raw_amount, (int, float)):
+                            amount = float(raw_amount)
+                        else:
+                            amount = 0.0
+                    except (ValueError, TypeError):
+                        amount = 0.0
+
+                    budget = Budget(
+                        year=year,
+                        jurisdiction=state_name,
+                        mda=item.get("mda") or item.get("ministry") or "Unknown",
+                        project=item.get("project_name") or item.get("description") or item.get("activity") or "Unknown",
+                        amount=amount,
+                        source_file=item.get("source_file", ""),
+                        page=item.get("page", 0),
+                    )
+                    session.add(budget)
+                    inserted += 1
+                    if inserted % 5000 == 0:
+                        session.commit()
+                        logger.info(f"    Committed {inserted} records...")
+
+        session.commit()
+        logger.info(f"  ✅ Inserted {inserted} budget records")
+
+    except Exception as e:
+        session.rollback()
+        logger.error(f"  ❌ Error inserting budgets: {e}")
+    finally:
+        session.close()
+
+    return inserted
+
+
+# ─────────────────────────────────────────────────────────────────────
+# VERIFICATION
+# ─────────────────────────────────────────────────────────────────────
+
+def verify_data():
+    """Print current database counts for all financial tables."""
+    from app.database import SessionLocal, Budget, Transaction, Finding
+
+    logger.info("=" * 60)
+    logger.info("VERIFICATION: Current Database Counts")
+    logger.info("=" * 60)
+
+    session = SessionLocal()
+    try:
+        budgets = session.query(Budget).count()
+        transactions = session.query(Transaction).count()
+        findings = session.query(Finding).count()
+
+        logger.info(f"  Budget records:      {budgets:,}")
+        logger.info(f"  Transaction records:  {transactions:,}")
+        logger.info(f"  Finding records:      {findings:,}")
+        logger.info(f"  TOTAL:                {budgets + transactions + findings:,}")
+
+        if findings > 0:
+            # Sample finding
+            sample = session.query(Finding).first()
+            logger.info(f"\n  Sample Finding: [{sample.jurisdiction}] {sample.title}")
+            logger.info(f"    Amount: ₦{sample.amount:,.0f}" if sample.amount else "    Amount: N/A")
+
+        if transactions > 0:
+            from sqlalchemy import func
+            total_amount = session.query(func.sum(Transaction.amount)).scalar()
+            logger.info(f"\n  Total Transaction Volume: ₦{total_amount:,.0f}" if total_amount else "")
+
+    except Exception as e:
+        logger.error(f"  Error during verification: {e}")
+    finally:
+        session.close()
+
+
+# ─────────────────────────────────────────────────────────────────────
+# MAIN
+# ─────────────────────────────────────────────────────────────────────
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Decide9ja — Unified Financial Data Ingestion"
+    )
+    parser.add_argument("--dry-run", action="store_true", help="Scan data without inserting")
+    parser.add_argument("--reset", action="store_true", help="Clear existing financial data first")
+    parser.add_argument("--findings-only", action="store_true", help="Only ingest findings")
+    parser.add_argument("--transactions-only", action="store_true", help="Only ingest transactions")
+    parser.add_argument("--budgets-only", action="store_true", help="Only ingest budgets")
+    parser.add_argument("--verify", action="store_true", help="Just verify current counts")
+    args = parser.parse_args()
+
+    logger.info("🇳🇬 Decide9ja Financial Data Ingestion")
+    logger.info(f"   Backend dir: {BACKEND_DIR}")
+    logger.info(f"   Dry run: {args.dry_run}")
+    logger.info("")
+
+    if args.verify:
+        verify_data()
+        return
+
+    if args.reset:
+        from app.database import SessionLocal, Budget, Transaction, Finding
+        logger.warning("⚠️  Resetting all financial tables...")
+        session = SessionLocal()
+        try:
+            session.query(Finding).delete()
+            session.query(Transaction).delete()
+            session.query(Budget).delete()
+            session.commit()
+            logger.info("  Tables cleared.")
+        except Exception as e:
+            session.rollback()
+            logger.error(f"  Reset failed: {e}")
+        finally:
+            session.close()
+
+    # Run ingestion steps
+    run_all = not (args.findings_only or args.transactions_only or args.budgets_only)
+
+    results = {}
+
+    if run_all or args.findings_only:
+        results["findings"] = ingest_findings(args.dry_run)
+
+    if run_all or args.transactions_only:
+        results["transactions"] = ingest_opentreasury(args.dry_run)
+
+    if run_all or args.budgets_only:
+        results["budgets"] = ingest_budgets(args.dry_run)
+
+    # Summary
+    logger.info("")
+    logger.info("=" * 60)
+    logger.info("INGESTION SUMMARY")
+    logger.info("=" * 60)
+    for source, count in results.items():
+        status = "✅" if count > 0 else "⚠️"
+        logger.info(f"  {status} {source}: {count:,} records")
+
+    # Verify final state
+    if not args.dry_run:
+        logger.info("")
+        verify_data()
+
+
+if __name__ == "__main__":
+    main()
